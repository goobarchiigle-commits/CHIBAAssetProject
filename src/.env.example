# =============================================================
# .env.example — このファイルをコピーして .env を作成してください
# cp .env.example .env
# .env は絶対に GitHub にアップロードしないこと（CLAUDE.md ルール3）
# =============================================================

# --- kabuステーション API ---
# kabuステーション > ツール設定 > API > API　パスワード
KABU_API_PASSWORD=YOUR_KABU_API_PASSWORD_HERE

# kabuステーションのポート（デフォルト: 18080）
KABU_API_PORT=18080

# --- 取引口座設定 ---
# 1=一般口座 / 2=特定口座 / 4=NISA口座
KABU_ACCOUNT_TYPE=4

# 取引パスワード（注文送信時に使用）
KABU_TRADE_PASSWORD=YOUR_KABU_TRADE_PASSWORD_HERE

# --- J-Quants API（バックテスト用データ取得）---
JQUANTS_MAIL_ADDRESS=your_email@example.com
JQUANTS_API_PASSWORD=your_jquants_password_here

# --- エラー通知メール設定（任意）---
# Gmail を使う場合: Googleアカウント > セキュリティ > アプリパスワード で発行
# アプリパスワード未設定でも発注・ログは正常動作（通知メールのみ不送信）
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=your_gmail@gmail.com
NOTIFY_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
NOTIFY_TO=destination@example.com
